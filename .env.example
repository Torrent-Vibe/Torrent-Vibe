# Example environment configuration
VITE_TRIAL_MODE=false
VITE_APP_VERSION_SUFFIX=
VITE_APP_NAME=qBittorrent Web UI
VITE_TRIAL_MAX_TORRENTS=5
VITE_TRIAL_UPGRADE_URL=https://your-upgrade-url.com

# Update center endpoint for per-client key registration
UPDATE_CENTER_URL=

VITE_APP_FORCE_USE_RENDERER_REQUEST=

# Dev closed loop: Docker linux/amd64 helper -> SSH replace on the download host
HELPER_SSH=
HELPER_REMOTE_BIN=.local/bin/torrent-vibe-helper
HELPER_REMOTE_SERVICE=torrent-vibe-helper.service
