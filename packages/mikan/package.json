{
  "name": "@torrent-vibe/mikan",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build:jscore": "esbuild src/jscore.ts --bundle --format=iife --global-name=MikanParser --platform=neutral --target=es2022 --outfile=../../apps/ios/Resources/MikanParser.js",
